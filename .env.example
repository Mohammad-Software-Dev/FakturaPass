DATABASE_URL=postgres://fakturapass:local-synthetic-only@127.0.0.1:5440/fakturapass
INVOICE_ENGINE_URL=http://127.0.0.1:8089
FAKTURAPASS_ENV=LOCAL
LOCAL_BROWSER_IDENTITY=enabled
# Optional local API identities: JSON object mapping a development-only token to tenant/actor. The active database membership determines the role; configured roles are ignored.
LOCAL_API_IDENTITIES={}
# No production credentials or real customer data in Release A.
# Optional OIDC browser mode. Supply secrets through the server environment.
# AUTH_MODE=oidc
# APP_ORIGIN=https://your-app.example
# OIDC_ISSUER=https://your-verified-issuer.example/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
